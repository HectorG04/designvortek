# ============================================================
# Design Vortex — Environment Variables
# Copy this file to `.env.local` and fill in your values.
# ============================================================

# --- Supabase ---
# Get these from https://supabase.com/dashboard → your project → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJ...your-anon-key...

# Service role key — server-side ONLY. Bypasses RLS. Never expose to browser.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJ...your-service-role-key...

# --- Site ---
# The public URL of the site (used for metadata, sitemap, og tags)
NEXT_PUBLIC_SITE_URL=https://designvortex.co

# --- Resend (optional — for transactional emails) ---
# Get from https://resend.com/api-keys
# Without RESEND_API_KEY, every send call becomes a console-log no-op so
# the order + subscription pipelines still work end-to-end in dev.
RESEND_API_KEY=re_...
FROM_EMAIL=hello@designvortex.co
ADMIN_NOTIFY_EMAIL=you@designvortex.co

# --- Stripe (required for live payments) ---
# Get from https://dashboard.stripe.com/apikeys
# Use sk_test_* / pk_test_* for local + preview, sk_live_* / pk_live_*
# in production. Without STRIPE_SECRET_KEY the /api/orders/[id]/approve
# and /api/subscriptions/checkout endpoints throw "STRIPE_SECRET_KEY not
# set" (intentional — we never silently skip a payment).
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Webhook signing secret — Stripe Dashboard → Developers → Webhooks → add
# endpoint pointing to {NEXT_PUBLIC_SITE_URL}/api/webhooks/stripe.
# Subscribe to: checkout.session.completed, invoice.paid,
#   invoice.payment_failed, customer.subscription.{deleted,paused,resumed}
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Subscription price IDs — create two recurring prices in
# Stripe Dashboard → Products with a 6-month minimum commitment:
#   $75/mo (Companion) and $150/mo (GM tier).
# Set "minimum_commitment_months: 6" on both products in Stripe.
STRIPE_PRICE_COMPANION=price_...
STRIPE_PRICE_GM_TIER=price_...

# --- SEO (optional — verification tokens) ---
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
